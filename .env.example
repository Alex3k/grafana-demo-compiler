# Compiler runtime
DEMO_COMPILER_ADDR=:8080
DEMO_COMPILER_DATA_DIR=./data

# Amazon Bedrock. The model can be changed without changing code.
AWS_REGION=us-east-1
# AWS_PROFILE=your-sso-profile
BEDROCK_MODEL_ID=

# Conservative context budget. Defaults suit current frontier Bedrock models.
DEMO_COMPILER_CONTEXT_MAX_INPUT_TOKENS=32000
DEMO_COMPILER_CONTEXT_SAFETY_TOKENS=1500
DEMO_COMPILER_CONTEXT_PROVIDER_OVERHEAD_TOKENS=1000
DEMO_COMPILER_CONTEXT_BYTES_PER_TOKEN=3

# Grafana Agent Observability generation ingest.
AGENTO11Y_ENDPOINT=
AGENTO11Y_PROTOCOL=http
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_AUTH_TENANT_ID=
AGENTO11Y_AUTH_TOKEN=

# Grafana Cloud OTLP traces and metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
